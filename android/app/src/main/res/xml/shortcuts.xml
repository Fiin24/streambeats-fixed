            android:targetClass="com.musickuzyy.streambeats.MainActivity" android:data="com.musickuzyy.streambeats://open/resume" />
    </shortcut>
    <shortcut android:shortcutId="together" android:enabled="true" android:icon="@drawable/ic_shortcut_group"
