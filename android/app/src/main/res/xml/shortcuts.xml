            android:targetClass="com.musickuzyy.streambeats.MainActivity" android:data="com.musickuzyy.streambeats://open/together" />
    </shortcut>
    <shortcut android:shortcutId="voice" android:enabled="true" android:icon="@drawable/ic_shortcut_mic"
