<?xml version="1.0" encoding="utf-8"?>
<!-- Shortcut saat ikon aplikasi ditekan lama -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="play_liked" android:enabled="true" android:icon="@drawable/ic_shortcut_heart"
        android:shortcutShortLabel="@string/sc_liked_short" android:shortcutLongLabel="@string/sc_liked_long">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="com.musickuzyy.streambeats"
            android:targetClass="com.musickuzyy.streambeats.MainActivity" android:data="com.musickuzyy.streambeats://open/play-liked" />
    </shortcut>
    <shortcut android:shortcutId="resume" android:enabled="true" android:icon="@drawable/ic_shortcut_play"
