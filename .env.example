# OPSIONAL. Aplikasi sudah jalan TANPA API key: data lagu diambil langsung dari YouTube Music (InnerTube, seperti Metrolist)
# dan diputar lewat YouTube IFrame Player.
# Isi kunci YouTube Data API v3 bila ingin cadangan pencarian saat InnerTube gagal / diblokir di region server.
YOUTUBE_API_KEY=

# ── APK (Capacitor) ──────────────────────────────────────────────────────────
# URL situs yang sudah di-deploy (Vercel/Netlify). APK memuat situs ini, jadi update web
# langsung ikut ke APK. Dipakai saat `npx cap sync android`.
CAP_SERVER_URL=https://streambeast.netlify.app

# ── Akun (v3.7): daftar biasa (nama, username, password) TANPA kode verifikasi, sinkron cloud ──
# Tanpa database + AUTH_SECRET, fitur akun otomatis mati dan aplikasi berjalan dalam mode tamu.
#
# 1) Database — Upstash Redis (gratis): https://console.upstash.com → Create Database → tab "REST API"
#    (Di Vercel juga bisa lewat Storage/Marketplace → Upstash; KV_REST_API_URL/KV_REST_API_TOKEN dikenali otomatis.)
#    Akun & hash password (scrypt) disimpan di sini.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#
# 2) Kunci rahasia untuk menandatangani sesi (acak, min. 16 karakter). Contoh membuat:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
#
# 3) Pembekuan login (opsional): salah password sebanyak LOGIN_MAX_ATTEMPTS kali
#    → input password akun itu dibekukan LOGIN_LOCK_MINUTES menit.
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCK_MINUTES=5
#
# 4) Login/daftar dengan Google (Gmail) — v4.3. Kosongkan bila tidak dipakai (tombol Google otomatis disembunyikan).
#    Google Cloud Console → APIs & Services → Credentials → Create credentials → OAuth client ID → "Web application"
#    Authorized redirect URIs: https://DOMAIN-KAMU/api/google-callback   (mis. https://streambeast.netlify.app/api/google-callback)
#    Lokal: http://localhost:5173/api/google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opsional: paksa alamat situs untuk redirect URI (bawaan: domain yang sedang dibuka)
APP_URL=
#
# Opsional: 1 = tampilkan tombol "Lanjut tanpa akun" (login tidak wajib)
AUTH_OPTIONAL=
# Opsional (lokal): 0 = matikan mode pengembang di `npm run dev` (pakai database Upstash sungguhan)
AUTH_DEV=
